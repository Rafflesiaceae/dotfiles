#!/bin/bash
set -eo pipefail
die() {
    printf '%b\n' "$1" >&2
    exit "${2-1}"
}

move() {
    from="$(realpath "$1")"
    if [[ "$from" == *"$PWD"* ]]; then
        die "${from} is already linked!"
    fi
    if [[ "$from" != "$HOME"/** ]]; then
        die "I don't move files outside of \$HOME"
    fi
    file=${from#"${HOME}"/}
    # echo "$file"
    to="${HOME}/.numdots/${file}"

    [[ ! -f "$from" ]] && die "from: $from should exist"
    [[ -f "$to" ]] && die "to: $to should not exist"

    echo "$from => $to"
    mv "$from" "$to"
    python3 - "$file" <<'PY'
import ast
import json
import re
import sys
from pathlib import Path

entry_key = "./" + sys.argv[1]
list_path = Path("list.py")
lines = list_path.read_text().splitlines(keepends=True)
start = next(i for i, line in enumerate(lines) if line.strip() == "sources = {")
end = next(i for i in range(start + 1, len(lines)) if lines[i].strip() == "}")

# Match only four-space source entries, not nested platform targets.
key_pattern = re.compile(r'^    ("(?:\\.|[^"\\])*")\s*:')
existing_keys = []
for i in range(start + 1, end):
    match = key_pattern.match(lines[i])
    if match:
        existing_keys.append((ast.literal_eval(match.group(1)), i))

if not any(key == entry_key for key, _ in existing_keys):
    entry_line = f"    {json.dumps(entry_key)}: \"\",\n"
    sort_key = entry_key.casefold()
    insert_at = next(
        (i for key, i in existing_keys if key.casefold() > sort_key), end
    )
    lines.insert(insert_at, entry_line)
    list_path.write_text("".join(lines))
PY
    git add "$file"
}

for arg in "$@"; do
    if [[ -f "$arg" ]]; then
        (move "$arg") || true
        :
    else
        argwhich=$(which "$arg") || continue
        if [[ -f "$argwhich" ]]; then
            (move "$argwhich") || true
        fi
    fi
done
