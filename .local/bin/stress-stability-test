#!/usr/bin/env bash
# system-stability-test
#
# Quick whole-system stability check for Arch Linux.
#
# CPU + RAM + disk run concurrently for the whole test.
#
# GPU lane:
#   1. vkmark           -> GPU core/rendering/driver stress
#   2. memtest_vulkan   -> verified VRAM stress
#
# Disk testing is NON-DESTRUCTIVE:
#   - creates a temporary file on the selected filesystem
#   - writes + checksum-verifies it once
#   - spends remaining time doing verified random reads
#   - removes the file afterwards
#
# Default runtime: 5 minutes
#
# Exit status:
#   0 = PASS
#   1 = FAIL
#   2 = usage/preflight error
#   3 = PASS WITH WARNINGS
set -uo pipefail

DURATION=300
RAM_PCT=70
DISK_DIR="$PWD"
DISK_MAX_GIB=4

usage() {
    echo "Usage: $0 [-t seconds] [-d disk-dir] [-r ram-percent]"
    exit 0
}

while (($#)); do
    case "$1" in
        -t) DURATION=$2; shift 2 ;;
        -d) DISK_DIR=$2; shift 2 ;;
        -r) RAM_PCT=$2; shift 2 ;;
        -h|--help) usage ;;
        *) echo "Unknown option: $1" >&2; exit 2 ;;
    esac
done

(( DURATION >= 60 && DURATION <= 600 )) ||
    { echo "Duration must be 60-600 seconds" >&2; exit 2; }

for cmd in stress-ng fio timeout findmnt; do
    command -v "$cmd" >/dev/null ||
        { echo "Missing required command: $cmd" >&2; exit 2; }
done

DISK_DIR=$(realpath "$DISK_DIR")
[[ -d $DISK_DIR && -w $DISK_DIR ]] ||
    { echo "Disk directory not writable: $DISK_DIR" >&2; exit 2; }

FSTYPE=$(findmnt -T "$DISK_DIR" -no FSTYPE 2>/dev/null)
[[ $FSTYPE != tmpfs && $FSTYPE != ramfs ]] ||
    { echo "$DISK_DIR is on $FSTYPE, not a real disk filesystem" >&2; exit 2; }

LOG=$(mktemp -d /tmp/system-stability-test.XXXXXX)
DISK_FILE="$DISK_DIR/.stability-test-$$.dat"

CPU_STATUS="$LOG/cpu.status"
GPU_STATUS="$LOG/gpu.status"
VRAM_STATUS="$LOG/vram.status"
DISK_STATUS="$LOG/disk.status"

START_EPOCH=$(date +%s)
START_SECONDS=$SECONDS

CPU_THREADS=$(nproc)
VM_WORKERS=$(( CPU_THREADS / 4 ))
(( VM_WORKERS < 2 )) && VM_WORKERS=2
(( VM_WORKERS > 8 )) && VM_WORKERS=8

GPU_CORE_TIME=$(( DURATION / 5 ))
(( GPU_CORE_TIME < 20 )) && GPU_CORE_TIME=20
(( GPU_CORE_TIME > 60 )) && GPU_CORE_TIME=60
GPU_VRAM_TIME=$(( DURATION - GPU_CORE_TIME ))

# Cap disk test to 4 GiB and no more than 1/8 of free space.
FREE=$(df -B1 --output=avail "$DISK_DIR" | tail -1)
DISK_BYTES=$(( DISK_MAX_GIB * 1024 * 1024 * 1024 ))
(( FREE / 8 < DISK_BYTES )) && DISK_BYTES=$(( FREE / 8 ))

(( DISK_BYTES >= 512 * 1024 * 1024 )) ||
    { echo "Not enough free disk space" >&2; exit 2; }

status() {
    printf '%s|%s\n' "$2" "$3" >"$1"
}

cleanup() {
    for p in ${CPU_PID:-} ${GPU_PID:-} ${DISK_PID:-}; do
        kill "$p" 2>/dev/null || true
    done
    rm -f "$DISK_FILE"
}

trap 'cleanup; exit 130' INT TERM
trap 'rm -f "$DISK_FILE"' EXIT


# ---------------------------------------------------------------------------
# CPU + RAM
# ---------------------------------------------------------------------------

cpu_test() {
    if stress-ng \
        --cpu 0 \
        --cpu-load 100 \
        --cpu-method all \
        --vm "$VM_WORKERS" \
        --vm-bytes "${RAM_PCT}%" \
        --vm-method all \
        --vm-keep \
        --verify \
        --timeout "${DURATION}s" \
        --metrics-brief \
        >"$LOG/cpu.log" 2>&1
    then
        status "$CPU_STATUS" PASS "stress-ng completed with verification"
    else
        status "$CPU_STATUS" FAIL "stress-ng reported an error"
    fi
}


# ---------------------------------------------------------------------------
# Disk
# ---------------------------------------------------------------------------

disk_test() {
    local end=$(( SECONDS + DURATION ))
    local remaining

    if ! fio \
        --name=write-verify \
        --filename="$DISK_FILE" \
        --size="$DISK_BYTES" \
        --ioengine=io_uring \
        --direct=1 \
        --rw=write \
        --bs=256k \
        --iodepth=16 \
        --verify=crc32c \
        --verify_fatal=1 \
        --do_verify=1 \
        --fsync_on_close=1 \
        --group_reporting \
        >"$LOG/disk.log" 2>&1
    then
        status "$DISK_STATUS" FAIL "fio write/read verification failed"
        rm -f "$DISK_FILE"
        return
    fi

    # Spend remaining time repeatedly reading and checksum-verifying
    # the already-written file, without adding more SSD wear.
    remaining=$(( end - SECONDS ))

    if (( remaining > 5 )); then
        if ! fio \
            --name=verified-read \
            --filename="$DISK_FILE" \
            --size="$DISK_BYTES" \
            --ioengine=io_uring \
            --direct=1 \
            --rw=randread \
            --bs=256k \
            --iodepth=32 \
            --time_based \
            --runtime="$remaining" \
            --verify=crc32c \
            --verify_fatal=1 \
            --verify_header_seed=0 \
            --group_reporting \
            >>"$LOG/disk.log" 2>&1
        then
            status "$DISK_STATUS" FAIL "fio verified random reads failed"
            rm -f "$DISK_FILE"
            return
        fi
    fi

    rm -f "$DISK_FILE"
    status "$DISK_STATUS" PASS "fio checksum verification completed"
}


# ---------------------------------------------------------------------------
# GPU core + VRAM
# ---------------------------------------------------------------------------

gpu_test() {
    local rc elapsed start

    : >"$LOG/gpu.log"

    # ---- GPU core ---------------------------------------------------------

    if ! command -v vkmark >/dev/null; then
        status "$GPU_STATUS" SKIP "vkmark not installed"
    else
        echo "=== vkmark ===" >>"$LOG/gpu.log"

        start=$SECONDS
        timeout -s TERM -k 5 "${GPU_CORE_TIME}s" \
            vkmark --size 1920x1080 --run-forever \
            >>"$LOG/gpu.log" 2>&1
        rc=$?
        elapsed=$(( SECONDS - start ))

        if (( rc == 124 )); then
            status "$GPU_STATUS" PASS "vkmark sustained ${GPU_CORE_TIME}s"

        elif (( elapsed < 10 )) &&
             grep -Eqi 'Error|failed|not present|unsupported' "$LOG/gpu.log"
        then
            # Couldn't initialize != unstable hardware.
            status "$GPU_STATUS" SKIP "vkmark could not initialize; see gpu.log"

        else
            status "$GPU_STATUS" FAIL \
                "vkmark exited unexpectedly after ${elapsed}s (rc=$rc)"
        fi
    fi

    # ---- VRAM ------------------------------------------------------------

    # Always run this even if vkmark failed or was unavailable.
    if ! command -v memtest_vulkan >/dev/null; then
        status "$VRAM_STATUS" SKIP "memtest_vulkan not installed"
        return
    fi

    echo >>"$LOG/gpu.log"
    echo "=== memtest_vulkan ===" >>"$LOG/gpu.log"

    start=$SECONDS

    # Newline selects the default Vulkan device.
    # SIGINT makes memtest_vulkan print its final result.
    printf '\n' |
        timeout -s INT -k 10 "${GPU_VRAM_TIME}s" \
            memtest_vulkan \
            >>"$LOG/gpu.log" 2>&1

    rc=${PIPESTATUS[1]}
    elapsed=$(( SECONDS - start ))

    if grep -Eqi 'Error found|errors:[[:space:]]*[1-9]' "$LOG/gpu.log"; then
        status "$VRAM_STATUS" FAIL "memtest_vulkan detected VRAM errors"

    elif grep -Eqi 'no any errors.*PASS|testing PASSed' "$LOG/gpu.log"; then
        status "$VRAM_STATUS" PASS "memtest_vulkan found no VRAM errors"

    elif (( elapsed < 10 )); then
        status "$VRAM_STATUS" SKIP \
            "memtest_vulkan could not initialize; see gpu.log"

    elif (( rc == 124 )); then
        status "$VRAM_STATUS" WARN \
            "no VRAM errors seen, but no final PASS marker"

    else
        status "$VRAM_STATUS" FAIL \
            "memtest_vulkan exited unexpectedly (rc=$rc)"
    fi
}


# ---------------------------------------------------------------------------
# Run
# ---------------------------------------------------------------------------

GPU_NAME=$(
    nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null |
        head -1
)
GPU_NAME=${GPU_NAME:-"Vulkan GPU"}

echo "System stability test"
echo "  duration : ${DURATION}s"
echo "  CPU      : $CPU_THREADS logical CPUs"
echo "  RAM      : ${RAM_PCT}% available RAM, $VM_WORKERS workers"
echo "  GPU      : $GPU_NAME"
echo "             ${GPU_CORE_TIME}s core + ${GPU_VRAM_TIME}s VRAM"
echo "  disk     : $DISK_DIR ($FSTYPE), $(numfmt --to=iec "$DISK_BYTES") test file"
echo "  logs     : $LOG"
echo

cpu_test  &
CPU_PID=$!

gpu_test  &
GPU_PID=$!

disk_test &
DISK_PID=$!

while kill -0 "$CPU_PID" 2>/dev/null ||
      kill -0 "$GPU_PID" 2>/dev/null ||
      kill -0 "$DISK_PID" 2>/dev/null
do
    elapsed=$(( SECONDS - START_SECONDS ))

    printf '[%3ds/%ss]' "$elapsed" "$DURATION"

    if command -v nvidia-smi >/dev/null; then
        gpu=$(
            nvidia-smi \
                --query-gpu=temperature.gpu,power.draw,utilization.gpu,memory.used,memory.total \
                --format=csv,noheader,nounits 2>/dev/null |
                head -1
        )
        [[ -n $gpu ]] && printf ' GPU: %s' "$gpu"
    fi

    echo
    sleep 10
done

wait "$CPU_PID"  2>/dev/null
wait "$GPU_PID"  2>/dev/null
wait "$DISK_PID" 2>/dev/null


# ---------------------------------------------------------------------------
# Kernel errors
# ---------------------------------------------------------------------------

KERNEL_STATUS="$LOG/kernel.status"

journalctl -k --since "@$START_EPOCH" --no-pager -q \
    >"$LOG/kernel.log" 2>/dev/null

grep -Eai \
    'machine check|hardware error|\bmce:|edac.*uncorrect|nvrm:.*xid|pcie.*(fatal|uncorrect)|nvme.*(timeout|reset|i/o error)|ata[0-9].*(error|hard resetting)|buffer i/o error|ext4-fs error|btrfs.*(error|corrupt)|watchdog:.*(soft|hard) lockup|rcu.*stall' \
    "$LOG/kernel.log" >"$LOG/kernel-errors.log" 2>/dev/null

if [[ -s $LOG/kernel-errors.log ]]; then
    status "$KERNEL_STATUS" FAIL "hardware/storage/kernel errors appeared"
else
    status "$KERNEL_STATUS" PASS "no obvious hardware/kernel errors"
fi


# ---------------------------------------------------------------------------
# Results
# ---------------------------------------------------------------------------

echo
echo "Results"

FAIL=0
WARN=0

show() {
    local file=$1 name=$2 s msg

    if [[ ! -f $file ]]; then
        s=FAIL
        msg="test did not produce a result"
    else
        IFS='|' read -r s msg <"$file"
    fi

    printf '  %-5s %-10s %s\n' "$s" "$name" "$msg"

    [[ $s == FAIL ]] && FAIL=1
    [[ $s == WARN || $s == SKIP ]] && WARN=1
}

show "$CPU_STATUS"    "CPU/RAM"
show "$GPU_STATUS"    "GPU"
show "$VRAM_STATUS"   "VRAM"
show "$DISK_STATUS"   "disk"
show "$KERNEL_STATUS" "kernel"

echo
echo "Logs: $LOG"

if (( FAIL )); then
    echo "OVERALL: FAIL"
    exit 1
elif (( WARN )); then
    echo "OVERALL: PASS WITH WARNINGS"
    exit 3
else
    echo "OVERALL: PASS"
    exit 0
fi
