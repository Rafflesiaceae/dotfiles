#!/usr/bin/env bash
set -eo pipefail
doit() {
    find . -regex "$1" -printf '%P\0' 2> >(grep -v "Permission denied" ) | xargs -r0 -I '{}' bash -c 'echo "{}"; bkm "{}"'
}

doit ".*_LOCAL_.*" || true
doit ".*_REMOTE_.*" || true
doit ".*_BACKUP_.*" || true
doit ".*_BASE_.*" || true
doit "^.*\.rej$" || true
