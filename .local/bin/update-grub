#!/usr/bin/env bash
set -eo pipefail

prompt_continue() {
    [[ $absolute_yes ]] && return
    tput sc
    while true; do
        read -p "${1:-Continue?} (y/n) " -n 1 -r yn
        case $yn in
            [Y]*) declare -g absolute_yes=1; break ;;
            [y]*) break ;;
            [Nn]*) printf "\n"; exit 0 ;;
            *) tput el1; tput rc ;;
        esac
    done
    printf "\n"
}

if [[ -d /sys/firmware/efi ]]; then
    cmd="sudo bash -c 'mkinitcpio -P && grub-install --target=x86_64-efi --efi-directory=/boot/efi --bootloader-id=GRUB && grub-mkconfig -o /boot/grub/grub.cfg'"
else
    cmd="sudo bash -c 'mkinitcpio -P && grub-install --target=i386-pc /dev/sda && grub-mkconfig -o /boot/grub/grub.cfg'"
fi

echo "+ $cmd"
if [[ "$1" != "-y" ]]; then
    prompt_continue
fi
eval "$cmd"
