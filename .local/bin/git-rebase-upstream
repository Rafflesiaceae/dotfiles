#!/usr/bin/env bash

set -eo pipefail

report_failure() {
    status=$?
    if ((status != 0)); then
        printf 'git-rebase-upstream: failed (exit %d)\n' "$status" >&2
    fi
}
trap report_failure EXIT

current_branch=$(git symbolic-ref --quiet --short HEAD) || {
    printf 'git-rebase-upstream: detached HEAD; skipping\n' >&2
    exit 0
}

# Preserve the old early exit for a branch with no configured pull upstream,
# but do it before contacting any remote.
mapfile -t branch_info < <(git for-each-ref --count=1 \
    --format='%(upstream:short)%0a%(upstream:remotename)' \
    "refs/heads/$current_branch")
tracking_ref=${branch_info[0]-}
tracking_remote=${branch_info[1]-}
if [[ -z $tracking_ref ]]; then
    printf "git-rebase-upstream: branch '%s' has no upstream; skipping\n" \
        "$current_branch" >&2
    exit 0
fi

upstream_remote=upstream
if ! git config --get "remote.$upstream_remote.url" >/dev/null; then
    upstream_remote=origin
fi

# Fetch only the remotes used by this command. The nested gitup receives
# --no-fetch, so each remote is contacted at most once for the whole call.
declare -A seen_remote=()
declare -a fetch_remotes=()
for remote in "$tracking_remote" "$upstream_remote"; do
    if [[ -n $remote && $remote != . && ! ${seen_remote["$remote"]+yes} ]]; then
        seen_remote["$remote"]=1
        fetch_remotes+=("$remote")
    fi
done

fetch_options=(
    --quiet
    --prune
    --no-auto-maintenance
    --no-write-commit-graph
    --no-write-fetch-head
)
if ((${#fetch_remotes[@]} == 1)); then
    git fetch "${fetch_options[@]}" "${fetch_remotes[0]}"
elif ((${#fetch_remotes[@]} > 1)); then
    git fetch --multiple --jobs=0 "${fetch_options[@]}" \
        "${fetch_remotes[@]}"
fi

script_dir=${BASH_SOURCE[0]%/*}
[[ $script_dir == "${BASH_SOURCE[0]}" ]] && script_dir=.
"$script_dir/gitup" --no-fetch --quiet

case ${1-} in
c | current | u | upstream)
    upstream_branch="$upstream_remote/$current_branch"
    ;;
'')
    if git show-ref --verify --quiet "refs/remotes/$upstream_remote/main"; then
        upstream_branch="$upstream_remote/main"
    elif git show-ref --verify --quiet "refs/remotes/$upstream_remote/master"; then
        upstream_branch="$upstream_remote/master"
    else
        printf 'git-rebase-upstream: cannot determine upstream branch\n' >&2
        exit 1
    fi
    ;;
*)
    upstream_branch="$upstream_remote/$1"
    ;;
esac

if git merge-base --is-ancestor "$upstream_branch" "$current_branch"; then
    printf "git-rebase-upstream: '%s' is up to date with '%s'\n" \
        "$current_branch" "$upstream_branch"
else
    status=$?
    if ((status != 1)); then
        printf "git-rebase-upstream: cannot compare '%s' with '%s'\n" \
            "$current_branch" "$upstream_branch" >&2
        exit 1
    fi
    git rebase --quiet --autostash "$upstream_branch"
    printf "git-rebase-upstream: rebased '%s' onto '%s'\n" \
        "$current_branch" "$upstream_branch"
fi
