#!/usr/bin/env hacman
# Single-file hotkey overview: Python stdlib + Chromium, no pip packages.
# Run: ./hotkey-overview.siml
name: hotkey-overview
command: python3 -c 'import os; os.chmod("render.py", 0o755)'
bin-path: render.py
files:
  hotkeys.toml: |
    [canvas]
    width = 1920
    height = 1050
    output = "overview.png"  # relative to the working directory; absolute paths work too

    [layout]
    columns = 5
    rows = 5
    section_height = 30  # height in pixels for each header element
    # section_color = "muted"  # default header color
    gap = 18
    padding = 42
    hide_index = true  # true hides the card number in the top-right corner

    [overview]
    # title = "I3 / HOTKEY OVERVIEW"
    # subtitle = "Window management   /   Arch Linux"
    title = ""
    subtitle = ""
    header_position = "bottom"  # "top" or "bottom"
    hide_header = true      # true removes both the header and its separator
    separator_color = "muted"  # palette name or #RRGGBB

    # From the supplied terminal screenshot. Override any value here.
    [palette]
    background = "#272822"
    card = "#1E1F1A"
    text = "#F8F8F2"
    muted = "#99947B"
    green = "#A6E22E"
    cyan = "#73E6E6"
    blue = "#33B9F3"
    yellow = "#FDD102"
    red = "#FF4535"
    purple = "#AE81FF"
    orange = "#FD971F"

    # Elements are rendered in declaration order.
    # Headers span all columns and force the following cards onto a new row.
    # Header colors default to layout.section_color; card colors default to green.
    # A card may set glow = true to highlight it.
    # Set muted = true to dim the entire card, including its border and text.
    # Cards with empty/omitted keys are informational; category = "" removes the label row.

    [[element]]
    kind = "header"
    title = "BASICS"
    color = "green"

    [[element]]
    kind = "card"
    keys = "Win+r"
    title = "Launcher"
    description = "Press this to launch an application"
