#!/bin/bash
set -eo pipefail

die() {
    printf '%s\n' "$1" >&2
    exit "${2-1}"
}

git-has-changes none || die "repo has staged/unstaged changes, these would be lost"


if [[ $# -gt 0 ]] && [[ $1 == "-" ]]; then
    shift
    git reset --hard HEAD~
    exit 0
    # commits="$(git rev-parse HEAD) $*" # default to latest commit
elif [[ $# -gt 0 ]]; then
    commits=$*
else
    die "pass me some commits, or '-' for HEAD/latest"
fi

# Anchor the replay range to the merge-base with the remote default branch
# instead of a fixed 2-week reflog window, so we only ever replay commits
# that are actually unpushed rather than re-touching already-merged history
# (which was prone to spurious conflicts on commits superseded upstream).
default_branch=$(git-remote-branch) || true
default_branch=${ORIGIN_BRANCH:-${default_branch:-master}}

remote="origin"
if git-has-remote "upstream"; then
    remote="upstream"
fi

base=$(git merge-base HEAD "${remote}/${default_branch}") || die "could not find merge-base with ${remote}/${default_branch}"

GIT_SEQUENCE_EDITOR="git-rebase-noninteractive --log --drop $commits" git rebase -i "$base"
