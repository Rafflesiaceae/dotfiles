#!/usr/bin/env python3
"""Drive repeated Claude handoff sessions inside a tmux pane.

Loop:
  1. type `handoff-continue` into the target pane (skipped on the first
     round if something is already running there, in that case the
     running session is watched instead)
  2. poll until the handoff file gets written after the session started
  3. wait for Claude to finish its turn, then exit it with Ctrl-C
  4. go back to 1

Usage:
  handoff-loop -t 0:0.0
  handoff-loop -t 0:0.0 -n 3          # stop after three sessions
"""

import argparse
import os
import subprocess
import sys
import time

DEFAULT_FILE = "/home/raf/workspace/reigw/claude-handoff.md"
DEFAULT_COMMAND = "handoff-continue"

# Shown in Claude Code's footer while a turn is in progress.
BUSY_MARKER = "esc to interrupt"


def log(msg):
    print(f"[{time.strftime('%H:%M:%S')}] {msg}", flush=True)


def tmux(*args):
    return subprocess.run(
        ["tmux", *args], check=True, capture_output=True, text=True
    ).stdout


def capture(target):
    """Return the text on the visible part of the pane."""
    return tmux("capture-pane", "-p", "-J", "-t", target)


def pane_children(target):
    """PIDs of the processes started by the pane's shell."""
    pid = tmux("display-message", "-p", "-t", target, "#{pane_pid}").strip()
    res = subprocess.run(["pgrep", "-P", pid], capture_output=True, text=True)
    return [int(p) for p in res.stdout.split()]


def pane_busy(target):
    """True if the pane's shell has a child process (e.g. claude) running."""
    return bool(pane_children(target))


def session_start(target):
    """Wall-clock start time of the session running in the pane.

    That is the oldest child of the pane's shell (the `handoff-continue`
    wrapper, or claude itself if it was started directly). ps only gives
    the elapsed time in whole seconds, which is precise enough here since
    the handoff file is written minutes into a session. Returns None if
    nothing is running.
    """
    pids = pane_children(target)
    if not pids:
        return None
    res = subprocess.run(
        ["ps", "-o", "etimes=", "-p", ",".join(map(str, pids))],
        capture_output=True, text=True,
    )
    elapsed = [int(e) for e in res.stdout.split()]
    if not elapsed:
        return None
    return time.time() - max(elapsed)


def mtime(path):
    """Modification time of path, or None if it does not exist."""
    try:
        return os.stat(path).st_mtime
    except FileNotFoundError:
        return None


def claude_working(target):
    """True while Claude Code shows its 'esc to interrupt' footer."""
    tail = capture(target).rstrip("\n").splitlines()[-6:]
    return any(BUSY_MARKER in line for line in tail)


def send_line(target, line):
    # -l sends the text literally, Enter is sent as a separate key.
    tmux("send-keys", "-t", target, "-l", line)
    tmux("send-keys", "-t", target, "Enter")


def handoff_written(path, since):
    """True if the handoff file was modified after `since`."""
    m = mtime(path)
    return m is not None and m > since


def wait_for_handoff(target, path, since, poll):
    """Block until the handoff file gets written after `since`.

    This does not depend on what Claude prints: the session counts as
    handed off as soon as the file is newer than the session's start,
    however the final message is worded. Returns False if the pane went
    idle without the file being written.
    """
    while True:
        if handoff_written(path, since):
            return True
        if not pane_busy(target):
            # The file may have been written right before the exit.
            return handoff_written(path, since)
        time.sleep(poll)


def wait_until_idle(target, timeout, poll):
    """Give Claude time to finish the turn in which it wrote the file."""
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        if not pane_busy(target) or not claude_working(target):
            return True
        time.sleep(poll)
    return False


def stop_claude(target, timeout):
    """Exit Claude Code via Ctrl-C until only the shell is left.

    The first Ctrl-C interrupts a running turn or clears typed input, a
    second one in quick succession exits Claude Code. Keys are only sent
    while something is still running so the shell does not get spammed.
    """
    deadline = time.monotonic() + timeout
    while pane_busy(target):
        if time.monotonic() > deadline:
            return False
        tmux("send-keys", "-t", target, "C-c")
        time.sleep(0.3)
        if pane_busy(target):
            tmux("send-keys", "-t", target, "C-c")
        time.sleep(1.5)
    return True


def main():
    ap = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    ap.add_argument("-t", "--target", required=True,
                    help="tmux target pane, e.g. 0:0.0 or %%3")
    ap.add_argument("-c", "--command", default=DEFAULT_COMMAND,
                    help="command typed into the pane (default: %(default)s)")
    ap.add_argument("-f", "--file", default=DEFAULT_FILE,
                    help="handoff file whose update ends a session "
                         "(default: %(default)s)")
    ap.add_argument("-n", "--iterations", type=int, default=0,
                    help="number of sessions to finish, 0 = forever (default)")
    ap.add_argument("--poll", type=float, default=2.0,
                    help="poll interval in seconds (default: %(default)s)")
    ap.add_argument("--idle-timeout", type=float, default=300.0,
                    help="max seconds to wait for Claude to finish its turn "
                         "after the file was written before stopping it "
                         "anyway (default: %(default)s)")
    ap.add_argument("--settle", type=float, default=3.0,
                    help="extra seconds to wait before stopping Claude "
                         "(default: %(default)s)")
    ap.add_argument("--stop-timeout", type=float, default=60.0,
                    help="max seconds to try exiting Claude (default: %(default)s)")
    args = ap.parse_args()

    # The pane's shell may have a different cwd, so a relative path would
    # silently point at the wrong file.
    path = os.path.abspath(args.file)

    # Fail early on a bad target. display-message exits 0 even for unknown
    # targets, list-panes does not.
    try:
        tmux("list-panes", "-t", args.target, "-F", "#{pane_id}")
    except subprocess.CalledProcessError as e:
        sys.exit(f"invalid tmux target {args.target!r}: {e.stderr.strip()}")

    done = 0
    while args.iterations == 0 or done < args.iterations:
        since = session_start(args.target)
        if since is not None:
            # Only expected on the first round: attach to the running
            # session and measure the file against when it was started,
            # so an already finished session is detected right away.
            log("Claude already running in pane, watching that session")
        else:
            since = time.time()
            log(f"starting {args.command!r}")
            send_line(args.target, args.command)

        if not wait_for_handoff(args.target, path, since, args.poll):
            log("session ended without writing the handoff file, stopping")
            return 1
        log("handoff file written, waiting for Claude to finish its turn")

        if not wait_until_idle(args.target, args.idle_timeout, args.poll):
            log(f"still working after {args.idle_timeout:.0f}s, stopping anyway")
        time.sleep(args.settle)

        log("stopping Claude")
        if not stop_claude(args.target, args.stop_timeout):
            log("could not stop Claude, giving up")
            return 1

        done += 1
        log(f"session {done} finished")
        # Let the shell redraw its prompt before typing into it again.
        time.sleep(1.0)

    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
