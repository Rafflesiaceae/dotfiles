#!/bin/bash
set -eo pipefail

device="airscan:w0:Brother MFC-L2710DN series"

while true; do
    imgpng="scan-brother-$(date +%s%N).png"

    (
        set -x
        scanimage \
            --source Flatbed \
            --device "$device" \
            --format=png \
            --output-file "$imgpng"
    )

    echo "  result: $(realpath "$imgpng")"
    echo "SPACE = scan another / ENTER = quit"

    IFS= read -rsn1 key </dev/tty || break
    [[ "$key" == " " ]] || break
done
