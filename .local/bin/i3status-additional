#!/usr/bin/env bash
# prints additional info to i3status in pango format
set -eo pipefail
die() {
    printf '%b\n' "$1" >&2
    exit "${2-1}"
}

case "$1" in
tick) # "main"
    print_contents() {
        result=()

        # local custom ones
        if command -v i3status-additional-local &>/dev/null; then
            result+=("$(i3status-additional-local)")
        fi

        # show count of running docker containers
        if command -v docker &>/dev/null && [[ "$(realpath "$(which docker)")" != "$(realpath "$(which podman)")" ]]; then
            docker_containers=""
            docker_containers=$(docker ps --format table | tail -n +2 | wc -l || true)
            if [[ "$docker_containers" -gt 0 ]]; then
                result+=("$(printf "docker: <span foreground='#1F97EE'>%s</span>" "${docker_containers}")")
            fi
        fi

        # show count of running pdm containers
        podman_containers=""
        podman_containers=$(podman ps --format table | tail -n +2 | wc -l || true)
        if [[ "$podman_containers" -gt 0 ]]; then
            result+=("$(printf "podman: <span foreground='#1F97EE'>%s</span>" "${podman_containers}")")
        fi

        # show count of failed systemd units
        systemd_failed_units=$(systemctl list-units --state=failed | tail -n 1 | awk '{ print $1 }')
        if [[ "$systemd_failed_units" -gt 0 ]]; then
            result+=("$(printf "systemd-failed:<span foreground='#FD0000'>%s</span>" "$((systemd_failed_units))")")
        fi

        # inform about possible ArchLinux upgrade (5+ days)
        if [[ -e /var/log/pacman.log ]]; then
            last_full_system_upgrade="$(grep -i 'full system upgrade' /var/log/pacman.log | tail -1 | awk -F'[][]' '{print $2}' | xargs -I{} date --date="{}" +%s)"
            if [ -n "$last_full_system_upgrade" ]; then
                now="$(date +%s)"
                days_since=$(((now - last_full_system_upgrade) / 86400))
                if [ "$days_since" -ge 5 ]; then
                    result+=("$(printf "<span foreground='#FDA202'>%s</span>" "Update ArchLinux")")

                fi
            fi
        fi

        # inform about possible Ubuntu upgrade (5+ days)
        if [[ -e /var/log/apt/history.log ]]; then
            last_full_system_upgrade="$(zcat -f /var/log/apt/history.log* | awk '/^Start-Date:/ { d = $2 " " $3 } /^Commandline:.* (dist-|full-)?upgrade( |$)/ { print d }' | sort | tail -1 | xargs -I{} date --date="{}" +%s || true)"
            days_since=$((($(date +%s) - last_full_system_upgrade) / 86400))
            if [ -n "$last_full_system_upgrade" ] && [ "$days_since" -ge 5 ]; then
                result+=("$(printf "<span foreground='#FDA202'>%s</span>" "Update Ubuntu")")
            fi
        fi

        # llm-usage
        if command -v llm-usage &>/dev/null; then
            claude_usage=$(llm-usage)
            textcolor='#FDFDFD'
            if [[ "$claude_usage" -gt 90 ]]; then
                textcolor='#FD0000'
            elif [[ "$claude_usage" -gt 80 ]]; then
                textcolor='#FDA202'
            fi
            result+=("$(printf "✴️<span foreground='%s'>%s%%</span>" "$textcolor" "$claude_usage")")
        fi

        echo "${result[@]}"

        ## printf "🏃<span foreground='#FD0000'>%s</span>" "error"
        ## printf "🏃<span foreground='#FDA202'>%s</span>" "warning"
        ## printf "🏃<span foreground='#AD8F5C'>%s</span>" "not-normal"
        ## printf "🏃%s" "normal"
    }

    out=$(print_contents)
    if [[ -n "$out" ]]; then
        # printf "<span foreground='white'>(<span foreground='#B3B3B3'>"
        printf "<span foreground='#B3B3B3'>"
        printf "%s" "$out"
        printf "</span>"
        # printf "</span> <span foreground='#B3B3B3'>|</span>"
        # printf "</span>)</span> \n"
    fi
    ;;
*) # daemon
    pipetmpf=/tmp/.i3status.additional.tmp
    pipef=/tmp/.i3status.additional
    separatorf=/tmp/.i3status.additional.separator
    cleanup() {
        printf "" >"$pipef"
    }
    trap 'cleanup' EXIT INT
    while :; do
        if [[ ! -e "$separatorf" ]]; then
            printf "<span foreground='#B3B3B3'>|</span>" > "$separatorf"
        fi
        ("$0" tick || echo "???") >"$pipetmpf"
        mv "$pipetmpf" "$pipef" || true
        sleep 10
    done
    ;;
esac
