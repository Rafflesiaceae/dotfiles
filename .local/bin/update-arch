#!/usr/bin/env bash
set -eo pipefail

# {{{1 utils
# colors are best-effort: tput can fail (e.g. no terminal / dumb TERM), in
# which case we silently fall back to uncolored output
cbold=$(2>/dev/null tput bold) || true
cblue=$(2>/dev/null tput setaf 4) || true
cred=$(2>/dev/null tput setaf 1) || true
creset=$(2>/dev/null tput sgr0) || true

# prints a colored section banner, used in place of plain `echo` so the
# script's progress is easy to scan while still keeping a `{{{1` vim
# foldmarker comment above each section for editing
banner() {
    printf '\n%s%s==>%s %s\n' "$cbold" "$cblue" "$creset" "$1"
}

# prints a colored error and aborts
die() {
    printf '%s%sERROR:%s %s\n' "$cbold" "$cred" "$creset" "$1" >&2
    exit 1
}

# {{{1 only run on Arch Linux
[[ -f /etc/arch-release ]] || die "this script only runs on Arch Linux"

# {{{1 run this script in tmux
banner "run this script in tmux"
if [[ "$1" != "--run" ]]; then
    if tmux has-session -t "update-arch" 2>/dev/null; then
        tmux attach-session -t "update-arch"
        exit 0
    fi

    tmux new-session -d -s "update-arch" "$0" "--run" "$@"
    tmux attach-session -t "update-arch"

    # find latest .cast file
    unset -v latest_cast_file
    for file in "${HOME}/.update_arch_"*".cast"; do
        if [[ -z "$latest_cast_file" ]] || [[ "$file" -nt "$latest_cast_file" ]]; then
            latest_cast_file=$file
        fi
    done

    # cat it, so the output survives the tmux session in the scrollback
    #
    # the recording contains everything programs sent to the (tmux)
    # terminal, including queries (e.g. nvim asks for the background color
    # via OSC 11, device attributes, DECRQM modes, kitty keyboard flags).
    # replaying those verbatim makes the real terminal answer them, and the
    # answers land in the tty input queue as if typed: after this script
    # exits zsh reads them, the BEL terminating the OSC 11 reply triggers
    # the ^G fzf widget and the rest shows up as garbage at the prompt.
    # so dump the raw output and strip every query (plus window ops like
    # resizing) before printing it
    asciinema convert -f raw "$latest_cast_file" - | perl -0777 -pe '
        s/\e\[[?>=]?[0-9;]*c//g;                         # DA1/DA2/DA3
        s/\e\[\??[0-9;]*n//g;                            # DSR / CPR
        s/\e\[\??[0-9;]*\$p//g;                          # DECRQM
        s/\e\[\?u//g;                                    # kitty keyboard flags
        s/\e\[>[0-9]*q//g;                               # XTVERSION
        s/\e\[[0-9;]*t//g;                               # window ops/reports
        s/\e\](?:1[0-9]|4;[0-9]+|52;[^;\a\e]*);\?(?:\a|\e\\)//g; # OSC color/clipboard queries
        s/\eP[\$+]q.*?\e\\//gs;                          # DECRQSS / XTGETTCAP
    '

    # anything we failed to filter still gets answered by the terminal, so
    # give it a moment to reply and then drain the tty input queue, which
    # keeps such replies from reaching the shell prompt
    if [[ -t 0 ]]; then
        while IFS= read -r -s -n 1 -t 0.2 _; do :; done
    fi

    exit 0
fi
shift

# {{{1 record itself
banner "record itself"
if [[ "$1" != "--no-record" ]]; then
    title=".update_arch_$(date +%s)"
    echo "recording output to ${HOME}/${title}.cast"
    asciinema rec \
        --command "\"$0\" --run --no-record" \
        --title "$title" \
        --quiet \
        "${HOME}/${title}.cast"
    exit 0
fi

setup-or-update-git-repo() {
    local repo_dir=$1
    local remote=$2

    mkdir -p "$repo_dir"
    if [[ -e "$repo_dir/.git" ]]; then
        # silence pushd/popd's directory-stack printout, we only care about
        # what `gru` itself reports
        pushd "$repo_dir" >/dev/null
        gru
        popd >/dev/null
    else
        git clone "$remote" "$repo_dir"
    fi
}

banner "====================== UPDATE ARCH ========================="

# {{{1 update numdots
banner "update numdots"
setup-or-update-git-repo \
    "${HOME}/.numdots" \
    "git@github.com:Rafflesiaceae/dotfiles.git"

# {{{1 update pkgbuilds
banner "update pkgbuilds"
setup-or-update-git-repo \
    "${HOME}/workspace/pkgbuilds" \
    "git@github.com:Rafflesiaceae/pkgbuilds.git"

# {{{1 update archlinux-keyring
banner "update archlinux-keyring"
sudo pacman -Sy --noconfirm
sudo pacman -S archlinux-keyring --noconfirm

# {{{1 update official packages
banner "update official packages"
sudo pacman -Syu --noconfirm

# {{{1 install custom pkgbuilds AND AUR
banner "install custom pkgbuilds AND AUR"
pushd "${HOME}/workspace/pkgbuilds" >/dev/null
./install.py
popd >/dev/null

# {{{1 --- POST INSTALL ---
banner "==================== POST INSTALL =========================="

# {{{1 update grub
banner "update grub"
update-grub -y

if [[ -z "$ARCH_NO_POST_INSTALL" ]]; then
    update-post-install
fi

# {{{1 System Checks
banner "System Checks"
check-system || true

printf '\n%s%sCONSIDER RESTARTING!%s\n' "$cbold" "$cyellow" "$creset"
