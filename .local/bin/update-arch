#!/usr/bin/env bash
set -eo pipefail

# {{{1 utils
# colors are best-effort: tput can fail (e.g. no terminal / dumb TERM), in
# which case we silently fall back to uncolored output
cbold=$(2>/dev/null tput bold) || true
cblue=$(2>/dev/null tput setaf 4) || true
cred=$(2>/dev/null tput setaf 1) || true
creset=$(2>/dev/null tput sgr0) || true

# prints a colored section banner, used in place of plain `echo` so the
# script's progress is easy to scan while still keeping a `{{{1` vim
# foldmarker comment above each section for editing
banner() {
    printf '\n%s%s==>%s %s\n' "$cbold" "$cblue" "$creset" "$1"
}

# prints a colored error and aborts
die() {
    printf '%s%sERROR:%s %s\n' "$cbold" "$cred" "$creset" "$1" >&2
    exit 1
}

# {{{1 only run on Arch Linux
[[ -f /etc/arch-release ]] || die "this script only runs on Arch Linux"

# {{{1 run this script in tmux
banner "run this script in tmux"
if [[ "$1" != "--run" ]]; then
    if tmux has-session -t "update-arch" 2>/dev/null; then
        tmux attach-session -t "update-arch"
        exit 0
    fi

    tmux new-session -d -s "update-arch" "$0" "--run" "$@"
    tmux attach-session -t "update-arch"

    # find latest .cast file
    unset -v latest_cast_file
    for file in "${HOME}/.update_arch_"*".cast"; do
        if [[ -z "$latest_cast_file" ]] || [[ "$file" -nt "$latest_cast_file" ]]; then
            latest_cast_file=$file
        fi
    done

    # cat it
    asciinema play -s 1000000 "$latest_cast_file"

    exit 0
fi
shift

# {{{1 record itself
banner "record itself"
if [[ "$1" != "--no-record" ]]; then
    title=".update_arch_$(date +%s)"
    echo "recording output to ${HOME}/${title}.cast"
    asciinema rec \
        --command "\"$0\" --run --no-record" \
        --title "$title" \
        --quiet \
        "${HOME}/${title}.cast"
    exit 0
fi

setup-or-update-git-repo() {
    local repo_dir=$1
    local remote=$2

    mkdir -p "$repo_dir"
    if [[ -e "$repo_dir/.git" ]]; then
        # silence pushd/popd's directory-stack printout, we only care about
        # what `gru` itself reports
        pushd "$repo_dir" >/dev/null
        gru
        popd >/dev/null
    else
        git clone "$remote" "$repo_dir"
    fi
}

# {{{1 update numdots
banner "update numdots"
setup-or-update-git-repo \
    "${HOME}/.numdots" \
    "git@github.com:Rafflesiaceae/dotfiles.git"

# {{{1 update pkgbuilds
banner "update pkgbuilds"
setup-or-update-git-repo \
    "${HOME}/workspace/pkgbuilds" \
    "git@github.com:Rafflesiaceae/pkgbuilds.git"

# {{{1 update archlinux-keyring
banner "update archlinux-keyring"
sudo pacman -Sy --noconfirm
sudo pacman -S archlinux-keyring --noconfirm

# {{{1 update official packages
banner "update official packages"
sudo pacman -Syu --noconfirm

# {{{1 install custom pkgbuilds AND AUR
banner "install custom pkgbuilds AND AUR"
pushd "${HOME}/workspace/pkgbuilds" >/dev/null
./install.py
popd >/dev/null

# {{{1 --- POST INSTALL ---
banner "--- POST INSTALL ---"

# {{{1 update grub
banner "update grub"
update-grub -y

update-post-install
