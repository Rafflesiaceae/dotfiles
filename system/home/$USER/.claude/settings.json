{
  "env": {
    "CLAUDE_CODE_DISABLE_ALTERNATE_SCREEN": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_DISABLE_MOUSE": "1",
    "CLAUDE_CODE_SHELL": "/bin/bash"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "model": "opus",
  "disableAgentView": true,
  "statusLine": {
    "type": "command",
    "command": "lust ~/.claude/statusline.lua",
    "padding": 0,
    "refreshInterval": 60
  },
  "spinnerTipsEnabled": false,
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "Working"
    ]
  },
  "effortLevel": "high",
  "modelSettings": {
    "claude-sonnet-5-5": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "high",
      "autoCompactWindow": 200000
    }
  },
  "tui": "default",
  "prefersReducedMotion": true,
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark-ansi",
  "autoCompactEnabled": true,
  "bindings": [
    {
      "context": "Chat",
      "bindings": {
        "escape": null
      }
    }
  ]
}
